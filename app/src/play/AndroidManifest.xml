<?xml version="1.0" encoding="utf-8"?>
<!-- Versi Google Play: buang apa yang Play tak benarkan atau perlukan deklarasi khas.
     Tiada internet langsung — semua semakan dalam phone. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />
    <!-- Pop-up atas app lain hanya diperlukan oleh Baca skrin -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove" />

    <application>
        <service android:name=".ScreenWatcher" tools:node="remove" />
        <service android:name=".UpdateJob" tools:node="remove" />
        <receiver android:name=".InstallResultReceiver" tools:node="remove" />
    </application>
</manifest>
